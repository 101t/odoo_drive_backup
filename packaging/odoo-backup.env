# Odoo Backup settings. Uncomment a line to change it, then restart the service:
#   Linux:   sudo systemctl restart odoo-backup
#   Windows: Restart-Service OdooBackup
# Upgrades keep this file. `odoo-backup --help` describes every option.

# Address and port of the web interface. Use 127.0.0.2:8080 when a reverse proxy on this server serves it.
#ODB_BIND=0.0.0.0:8080

# Address users open in their browser. Needed for Google OAuth and for links in notifications.
#ODB_PUBLIC_URL=https://backup.example.com

# Set to true when the interface is served over HTTPS (behind a reverse proxy).
#ODB_COOKIE_SECURE=true

# Runs executing at the same time (each buffers one backup on disk).
#ODB_MAX_CONCURRENT_JOBS=2

# Database, encryption key and temporary buffers. Back up this directory, or at least secret.key!
# Default: /var/lib/odoo-backup on Linux, C:\ProgramData\OdooBackup on Windows.
#ODB_DATA_DIR=/var/lib/odoo-backup

# Where backups are buffered on their way to the destinations (needs room for the largest backup).
# Default: the tmp folder in the data directory.
#ODB_TEMP_DIR=/var/lib/odoo-backup/tmp

# Keep the application data in PostgreSQL instead of the SQLite file in the data directory.
#ODB_DATABASE_URL=postgres://user:password@localhost:5432/odoo_backup

# Encryption key for stored secrets, instead of the generated secret.key (create one with: odoo-backup generate-key).
#ODB_SECRET_KEY=

# Create the first admin automatically instead of using the setup screen on the first visit.
#ODB_ADMIN_USERNAME=admin
#ODB_ADMIN_PASSWORD=

# Enable Prometheus metrics at /metrics (Authorization: Bearer <token>).
#ODB_METRICS_TOKEN=

# Log level: error, warn, info, debug or trace.
#RUST_LOG=info
